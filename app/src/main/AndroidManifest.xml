<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Agent-0 declares NO permissions at all.
        In particular there is no android.permission.INTERNET, which means the
        app is structurally incapable of transmitting anything off-device.
        This is a deliberate, verifiable privacy guarantee — not a promise.
    -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Agent0.Splash"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Agent0.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            No analytics, no ads, no exported services. One non-exported
            FileProvider (v2.0 Phase 5e) exists solely so the user can
            share their own certificate PNG/PDF from the app cache via
            the system chooser. It grants no permission and exposes no
            other file. The manifest's no-permissions guarantee is
            unchanged: this provider needs no permission.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/certificate_paths" />
        </provider>
    </application>

    <queries>
        <!-- So the browser/mail chooser can resolve for external references. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

</manifest>
