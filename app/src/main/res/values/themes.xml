<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Agent0" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
        Splash theme. Parent is Theme.Agent0 (not Theme.SplashScreen) so the
        project links even if the splashscreen AAR has not been resolved yet.
        MainActivity still calls installSplashScreen() for API 31+ splash.
    -->
    <style name="Theme.Agent0.Splash" parent="Theme.Agent0">
        <item name="android:windowBackground">@color/black</item>
    </style>

</resources>
