<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Agent0" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash: the sigil on black, matching the in-app boot sequence. -->
    <style name="Theme.Agent0.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_sigil</item>
        <item name="postSplashScreenTheme">@style/Theme.Agent0</item>
    </style>

</resources>
