<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground. The adaptive-icon safe zone is the centre 72x72 of the
    108x108 canvas, so the sigil is scaled to ~66% and centred to survive every
    mask shape (circle, squircle, rounded square).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="sigil"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.66"
        android:scaleY="0.66">

        <!-- outer ring -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="4.0"
            android:fillColor="#00000000"
            android:pathData="M54,20 A34,34 0 1,1 53.99,20 Z" />

        <!-- inner ring -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.0"
            android:fillColor="#00000000"
            android:pathData="M54,27 A27,27 0 1,1 53.99,27 Z" />

        <!-- cardinal reticle ticks -->
        <path android:fillColor="#FFFFFFFF" android:pathData="M52.5,10 h3 v9 h-3 z" />
        <path android:fillColor="#FFFFFFFF" android:pathData="M52.5,89 h3 v9 h-3 z" />
        <path android:fillColor="#FFFFFFFF" android:pathData="M10,52.5 h9 v3 h-9 z" />
        <path android:fillColor="#FFFFFFFF" android:pathData="M89,52.5 h9 v3 h-9 z" />

        <!-- shield -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.6"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M37,36 L71,36 L71,49 C71,61 63.5,69.5 54,74.5 C44.5,69.5 37,61 37,49 Z" />

        <!-- chief bar -->
        <path android:fillColor="#FFFFFFFF" android:pathData="M37,43.5 h34 v2.6 h-34 z" />

        <!-- keyhole ring -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.4"
            android:fillColor="#00000000"
            android:pathData="M54,51 m-5.5,0 a5.5,5.5 0 1,1 11,0 a5.5,5.5 0 1,1 -11,0" />

        <!-- keyhole stem -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M51.2,56.5 L56.8,56.5 L55.7,66.5 L52.3,66.5 Z" />

    </group>
</vector>
