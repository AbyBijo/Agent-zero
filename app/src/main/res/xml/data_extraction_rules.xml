<?xml version="1.0" encoding="utf-8"?>
<!--
    Agent-0 opts out of cloud backup and device-to-device transfer entirely.
    Training progress is local, disposable state; it should never be copied
    off the device by the platform on the user's behalf.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
